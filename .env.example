# ===================================================================
# Nizachem Restaurant & Bar - Environment Variables
# ===================================================================

# OPTION 1 (100% FREE - No credit card, no Google Cloud account needed):
# 1. Go to https://elfsight.com/google-reviews-widget/ (free forever tier)
# 2. Enter Nizachem's Google Maps link: https://maps.app.goo.gl/MfU9o8sQMLR79Eva6
# 3. Paste the generated Widget ID below:
VITE_GOOGLE_REVIEWS_WIDGET_ID=

# OPTION 2 (Google Cloud API Key - if you have one):
VITE_GOOGLE_MAPS_API_KEY=

# Nizachem Google Maps Place ID:
VITE_GOOGLE_PLACE_ID=
